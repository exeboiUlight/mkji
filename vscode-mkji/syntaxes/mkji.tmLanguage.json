{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MKJI",
  "scopeName": "source.mkji",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#use-statement" },
    { "include": "#class-declaration" },
    { "include": "#function-declaration" },
    { "include": "#new-expression" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#builtin-calls" },
    { "include": "#method-calls" },
    { "include": "#function-calls" },
    { "include": "#member-access" },
    { "include": "#primitive-types" },
    { "include": "#declaration-types" },
    { "include": "#array-brackets" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mkji",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mkji",
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.mkji" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.mkji" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mkji",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.mkji" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.mkji" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.mkji",
              "match": "\\\\(?:[ntr0\\\\\"']|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})"
            },
            {
              "name": "invalid.illegal.escape.mkji",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "use-statement": {
      "patterns": [
        {
          "name": "meta.use.mkji",
          "match": "\\b(use)\\s+(\"(?:\\\\.|[^\"\\\\])*\")",
          "captures": {
            "1": { "name": "keyword.control.import.mkji" },
            "2": { "name": "string.quoted.double.mkji" }
          }
        }
      ]
    },
    "class-declaration": {
      "patterns": [
        {
          "name": "meta.class.declaration.mkji",
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.class.mkji" },
            "2": { "name": "entity.name.type.class.mkji" }
          }
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "name": "meta.function.declaration.mkji",
          "begin": "\\b(fn)\\s+((?:[A-Za-z_][A-Za-z0-9_]*)(?:\\s*\\[\\s*\\])*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "storage.type.function.mkji" },
            "2": {
              "patterns": [
                { "include": "#primitive-types" },
                { "name": "entity.name.type.mkji", "match": "[A-Za-z_][A-Za-z0-9_]*" },
                { "name": "storage.modifier.array.mkji", "match": "\\[\\s*\\]" }
              ]
            },
            "3": { "name": "entity.name.function.definition.mkji" },
            "4": { "name": "punctuation.section.parameters.begin.mkji" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.parameters.end.mkji" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\s*(?:\\[\\s*\\])*)\\s+([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": {
                  "patterns": [
                    { "include": "#primitive-types" },
                    { "name": "entity.name.type.mkji", "match": "[A-Za-z_][A-Za-z0-9_]*" }
                  ]
                },
                "2": { "name": "storage.modifier.array.mkji" },
                "3": { "name": "variable.parameter.mkji" }
              }
            },
            { "name": "punctuation.separator.comma.mkji", "match": "," },
            { "include": "#primitive-types" }
          ]
        }
      ]
    },
    "new-expression": {
      "patterns": [
        {
          "name": "meta.new.mkji",
          "match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.new.mkji" },
            "2": {
              "patterns": [
                { "include": "#primitive-types" },
                { "name": "entity.name.type.mkji", "match": "[A-Za-z_][A-Za-z0-9_]*" }
              ]
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mkji",
          "match": "\\b(?:if|else|while|return)\\b"
        },
        {
          "name": "keyword.control.import.mkji",
          "match": "\\buse\\b"
        },
        {
          "name": "keyword.operator.new.mkji",
          "match": "\\bnew\\b"
        },
        {
          "name": "storage.type.function.mkji",
          "match": "\\bfn\\b"
        },
        {
          "name": "storage.type.class.mkji",
          "match": "\\bclass\\b"
        },
        {
          "name": "variable.language.this.mkji",
          "match": "\\bthis\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.mkji",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.mkji",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.null.mkji",
          "match": "\\bnull\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.mkji",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.mkji",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "builtin-calls": {
      "patterns": [
        {
          "match": "\\b(print|panic|read_file|write_file|str_from|arg_count|get_arg)\\s*(?=\\()",
          "captures": {
            "1": { "name": "support.function.builtin.mkji" }
          }
        }
      ]
    },
    "method-calls": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.dot.mkji" },
            "2": { "name": "entity.name.function.method.mkji" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.mkji" }
          }
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.dot.mkji" },
            "2": { "name": "variable.other.property.mkji" }
          }
        }
      ]
    },
    "primitive-types": {
      "patterns": [
        {
          "name": "support.type.primitive.mkji",
          "match": "\\b(?:int|bool|string|byte|void)\\b"
        }
      ]
    },
    "declaration-types": {
      "patterns": [
        {
          "comment": "Type and name in declarations: Type name; / Type name = / Type[] name ...",
          "match": "\\b(?!(?:if|else|while|return|fn|class|new|use|this|true|false|null|print|panic|read_file|write_file|str_from|arg_count|get_arg)\\b)([A-Za-z_][A-Za-z0-9_]*)(\\s*(?:\\[\\s*\\])*)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:=|;|,|\\)))",
          "captures": {
            "1": {
              "patterns": [
                { "include": "#primitive-types" },
                { "name": "entity.name.type.mkji", "match": "[A-Za-z_][A-Za-z0-9_]*" }
              ]
            },
            "2": { "name": "storage.modifier.array.mkji" },
            "3": { "name": "variable.other.declaration.mkji" }
          }
        }
      ]
    },
    "array-brackets": {
      "patterns": [
        {
          "name": "storage.modifier.array.mkji",
          "match": "\\[\\s*\\]"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.mkji",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.mkji",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.bitwise.mkji",
          "match": "<<|>>|&|\\||\\^"
        },
        {
          "name": "keyword.operator.arithmetic.mkji",
          "match": "\\+|\\-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.mkji",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.mkji",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.mkji",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.mkji",
          "match": "\\."
        },
        {
          "name": "punctuation.section.block.begin.mkji",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.mkji",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parens.begin.mkji",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.mkji",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.mkji",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.mkji",
          "match": "\\]"
        }
      ]
    }
  }
}
